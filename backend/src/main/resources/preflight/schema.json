{
  "slug": "iam",
  "title": "账号授权期限与特权MFA预检",
  "fields": [
    {
      "key": "grant_no",
      "label": "授权编号",
      "type": "ID",
      "length": 200
    },
    {
      "key": "account",
      "label": "账号",
      "type": "ID",
      "length": 200
    },
    {
      "key": "role",
      "label": "角色",
      "type": "ENUM",
      "length": 200,
      "options": [
        "ADMIN",
        "OPERATOR",
        "VIEWER"
      ]
    },
    {
      "key": "mfa",
      "label": "多因素认证",
      "type": "ENUM",
      "length": 200,
      "options": [
        "ENABLED",
        "DISABLED"
      ]
    },
    {
      "key": "start_date",
      "label": "生效日期",
      "type": "DATE",
      "length": 200
    },
    {
      "key": "end_date",
      "label": "失效日期",
      "type": "DATE",
      "length": 200
    }
  ],
  "unique": [
    [
      "grant_no"
    ],
    [
      "account",
      "role"
    ]
  ],
  "rules": [
    {
      "op": "IF_EQ",
      "args": [
        "role",
        "ADMIN",
        "mfa",
        "ENABLED"
      ],
      "code": "ADMIN_MFA",
      "message": "管理员授权要求启用MFA",
      "bad": {
        "mfa": "DISABLED"
      }
    },
    {
      "op": "DATE_LE",
      "args": [
        "start_date",
        "end_date"
      ],
      "code": "GRANT_DATE",
      "message": "授权失效日期不得早于生效日期",
      "bad": {
        "end_date": "2026-01-01"
      }
    },
    {
      "op": "EXPIRY",
      "args": [
        "end_date"
      ],
      "code": "EXPIRY",
      "message": "授权到期提醒",
      "bad": null
    }
  ],
  "sampleCsv": "grant_no,account,role,mfa,start_date,end_date\nGRANT-001,USER-01,ADMIN,ENABLED,2026-10-23,2026-12-31\n",
  "limits": {
    "rows": 500,
    "bytes": 262144,
    "columns": 32,
    "cellCharacters": 4000
  },
  "scope": "Read-only batch validation; no persistence, reference-master lookup or full production certification."
}
